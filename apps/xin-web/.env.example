# XinChat web — copy deploy/hosts.env.example → deploy/hosts.env, then:
#   node scripts/sync-hosts-env.js

NEXT_PUBLIC_LIVEKIT_URL=wss://xinchat.boostbunny.io:7443
# NEXT_PUBLIC_API_URL=  (empty = same-origin via nginx)
NEXT_PUBLIC_RCHAT_ORIGIN=https://rchat.boostbunny.io
NEXT_PUBLIC_XINCHAT_ORIGIN=https://xinchat.boostbunny.io

# Local dev:
# NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
