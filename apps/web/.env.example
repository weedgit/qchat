# Copy to .env.local or run: ./deploy/render-media-config.sh
# That script auto-detects this machine's IP/DNS and writes apps/web/.env.local.
#
# Override detection:
#   ./deploy/render-media-config.sh --host 203.0.113.10
#   LIVEKIT_NODE_IP=192.168.1.50 ./deploy/render-media-config.sh

# Browser-reachable LiveKit (must be this host's LAN/public IP, not Cursor localhost).
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# Optional. Leave unset for apiBaseUrl() → http://<page-host>:8080
# For nginx same-origin builds, redeploy.sh sets NEXT_PUBLIC_API_URL="" at build time.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
