# Rchat web — copy deploy/hosts.env.example → deploy/hosts.env, then:
#   node scripts/sync-hosts-env.js
#
# Or copy this file to .env and edit manually.

NEXT_PUBLIC_LIVEKIT_URL=wss://rchat.boostbunny.io:7443
# NEXT_PUBLIC_API_URL=  (empty = same-origin via nginx; set for direct API dev)
NEXT_PUBLIC_RCHAT_ORIGIN=https://rchat.boostbunny.io
NEXT_PUBLIC_XINCHAT_ORIGIN=https://xinchat.boostbunny.io

# Local dev (render-media-config.sh also writes .env.local):
# NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
