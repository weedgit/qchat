{
  "name": "qchat-desktop",
  "productName": "Qchat Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Qchat desktop shell (Electron + web client)",
  "author": "Qchat <dev@qchat.local>",
  "homepage": "https://github.com/qchat/qchat",
  "main": "src/main/index.js",
  "desktopName": "qchat-desktop",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/dev.js",
    "dev:desktop": "node scripts/launch.js --dev --url=http://localhost:3000",
    "dev:no-sandbox": "node scripts/dev.js --no-sandbox",
    "start:local": "node scripts/launch.js --url=http://localhost:3000",
    "start:server": "node scripts/launch.js --url=http://135.181.224.36",
    "start:headless": "xvfb-run -a node scripts/launch.js",
    "check": "node scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.qchat.desktop",
    "productName": "Qchat Desktop",
    "copyright": "Copyright © Qchat",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "production.json",
      "package.json",
      "assets/**/*"
    ],
    "extraMetadata": {
      "main": "src/main/index.js"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "icon": "assets/icon.png",
      "executableName": "qchat-desktop",
      "synopsis": "Qchat desktop client",
      "maintainer": "Qchat <dev@qchat.local>",
      "artifactName": "qchat-desktop-${version}-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png",
      "artifactName": "qchat-desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qchat Desktop"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "qchat-desktop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  }
}
