{
  "name": "qchat-desktop",
  "productName": "Qchat Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Qchat desktop shell (Electron + web client)",
  "main": "main.js",
  "scripts": {
    "start": "bash run.sh",
    "start:local": "QCHAT_WEB_URL=http://localhost:3000 bash run.sh",
    "start:dev": "QCHAT_DESKTOP_DEV=1 QCHAT_WEB_URL=http://localhost:3000 bash run.sh",
    "start:sandbox": "ELECTRON_DISABLE_SANDBOX= electron .",
    "start:headless": "xvfb-run -a bash run.sh",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.1.1"
  }
}
