{
  "name": "qchat-desktop",
  "productName": "Qchat Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Qchat desktop shell (Electron + web client)",
  "author": "Qchat <dev@qchat.local>",
  "homepage": "https://github.com/qchat/qchat",
  "main": "src/main/index.js",
  "desktopName": "qchat-desktop",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/dev.js",
    "dev:desktop": "node scripts/launch.js --dev --url=http://localhost:3000",
    "dev:no-sandbox": "node scripts/dev.js --no-sandbox",
    "start:local": "node scripts/launch.js --url=http://localhost:3000",
    "start:lan": "node scripts/launch-lan.js",
    "start:server": "node scripts/launch.js --url=https://135.181.224.36",
    "start:headless": "xvfb-run -a node scripts/launch.js",
    "check": "node scripts/check.js && node scripts/check-protocol.js && node scripts/check-context-menu.js && node scripts/check-sandbox.js && node scripts/check-signing.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win:signed": "electron-builder --win nsis",
    "dist:mac:signed": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.qchat.desktop",
    "productName": "Qchat Desktop",
    "copyright": "Copyright © Qchat",
    "afterPack": "./scripts/afterPack.js",
    "afterSign": "./scripts/afterSign.js",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "production.json",
      "package.json",
      "assets/**/*"
    ],
    "extraMetadata": {
      "main": "src/main/index.js"
    },
    "protocols": {
      "name": "Qchat",
      "schemes": [
        "qchat"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "executableName": "qchat-desktop",
      "synopsis": "Qchat desktop client",
      "maintainer": "Qchat <dev@qchat.local>",
      "artifactName": "qchat-desktop-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "qchat-desktop-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qchat Desktop"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "qchat-desktop-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
