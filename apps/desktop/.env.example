# Web UI origin for the Electron shell (dev override).
# Packaged builds default to production.json (https://135.181.224.36).
#
# Local Next.js:
#   QCHAT_WEB_URL=http://localhost:3000
# Deployed nginx (HTTPS; self-signed IP cert is trusted by the shell):
#   QCHAT_WEB_URL=https://135.181.224.36

QCHAT_WEB_URL=https://135.181.224.36

# Optional API origin for main-process fetches (captcha). Defaults to
# same host as QCHAT_WEB_URL on port 8080 (mirrors apps/web apiBaseUrl).
# QCHAT_API_URL=http://localhost:8080

# Open DevTools on launch
# QCHAT_DESKTOP_DEV=1

# Linux VM / Cursor tty without proper chrome-sandbox (DEV ONLY — ignored when packaged):
# QCHAT_DESKTOP_NO_SANDBOX=1

# Auto-update feed base URL (PACK-06). Packaged builds only; leave empty to disable.
# Must serve electron-builder generic artifacts (latest.yml / latest-linux.yml, etc.).
# QCHAT_UPDATE_URL=https://updates.example.com/qchat-desktop/
