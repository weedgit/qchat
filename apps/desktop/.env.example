# Web UI origin for the Electron shell (dev override).
# Packaged builds default to production.json (http://135.181.224.36).
#
# Local Next.js:
#   QCHAT_WEB_URL=http://localhost:3000
# Deployed nginx:
#   QCHAT_WEB_URL=http://135.181.224.36

QCHAT_WEB_URL=http://135.181.224.36

# Open DevTools on launch
# QCHAT_DESKTOP_DEV=1

# Linux VM / Cursor tty without proper chrome-sandbox:
# QCHAT_DESKTOP_NO_SANDBOX=1
