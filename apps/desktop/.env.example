# Rchat desktop — sync from deploy/hosts.env:
#   node scripts/sync-hosts-env.js
#
# Packaged installers use production.json (also updated by sync script).

QCHAT_WEB_URL=https://rchat.boostbunny.io

# Optional API origin for main-process fetches (captcha).
# QCHAT_API_URL=http://localhost:8080

# Local Next.js:
# QCHAT_WEB_URL=http://localhost:3000

# Auto-update feed (packaged builds):
# QCHAT_UPDATE_URL=https://rchat.boostbunny.io/desktop-updates/

# QCHAT_DESKTOP_DEV=1
# QCHAT_DESKTOP_NO_SANDBOX=1
