# XinChat desktop — Electron shell loading /xin/ web client.
#
# Local dev (xin-web on :3001):
#   XINCHAT_WEB_URL=http://localhost:3001/xin
#
# Deployed nginx:
#   XINCHAT_WEB_URL=https://135.181.224.36/xin
#
# Legacy alias QCHAT_WEB_URL is still read if XINCHAT_WEB_URL unset.

XINCHAT_WEB_URL=https://135.181.224.36/xin

# Optional API origin for main-process fetches (captcha).
# QCHAT_API_URL=http://localhost:8080

# Open DevTools on launch
# QCHAT_DESKTOP_DEV=1

# Linux VM dev only (ignored when packaged):
# QCHAT_DESKTOP_NO_SANDBOX=1

# Auto-update feed (packaged builds). Also XINCHAT_UPDATE_URL env alias.
# QCHAT_UPDATE_URL=https://your-host/xin-desktop-updates/

# --- Code signing (never commit secrets) ---
# CSC_LINK=... CSC_KEY_PASSWORD=...
# APPLE_ID=... APPLE_APP_SPECIFIC_PASSWORD=... APPLE_TEAM_ID=...
