# Phone/emulator must reach the API.
# For the self-signed deploy host, use HTTPS + a custom Android/iOS
# development build (see README). Expo Go cannot trust self-signed TLS.
EXPO_PUBLIC_API_URL=https://135.181.224.36
EXPO_PUBLIC_LIVEKIT_URL=wss://135.181.224.36:7443

# --- Release / EAS (do not commit real values) ---
# APP_ENV=production
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EXPO_PUBLIC_API_URL=https://chat.example.com
# EXPO_PUBLIC_LIVEKIT_URL=wss://chat.example.com:7443
#
# Signing is configured with `npx eas-cli credentials` (never commit *.jks / *.p8).
# Optional CI: repository secret EXPO_TOKEN for workflow_dispatch EAS builds.
# QCHAT_TRUST_CERT=0          # production default
# QCHAT_ALLOW_CLEARTEXT=0     # production default
# QCHAT_TRUST_HOST=chat.example.com
