# XinChat mobile — same API as Rchat, separate store listing (com.xinchat.mobile)

# Phone/emulator must reach the API.
EXPO_PUBLIC_API_URL=https://135.181.224.36
EXPO_PUBLIC_LIVEKIT_URL=wss://135.181.224.36:7443

# --- Release / EAS (do not commit real values) ---
# APP_ENV=production
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EXPO_PUBLIC_API_URL=https://chat.example.com
# EXPO_PUBLIC_LIVEKIT_URL=wss://chat.example.com:7443
#
# Separate Expo project from Rchat — run `npx eas-cli init` in apps/xin-mobile.
# Signing: `npx eas-cli credentials` (never commit *.jks / *.p8).
# Optional CI / headless VPS (do not commit):
# EXPO_TOKEN=...   # https://expo.dev/settings/access-tokens
# Then: npm run eas:ci-login && npm run eas:build:preview
# XINCHAT_TRUST_CERT=0          # production default
# XINCHAT_ALLOW_CLEARTEXT=0     # production default
