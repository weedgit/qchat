{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "XINCHAT_TRUST_CERT": "1",
        "XINCHAT_ALLOW_CLEARTEXT": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "preview",
        "XINCHAT_TRUST_CERT": "1",
        "XINCHAT_ALLOW_CLEARTEXT": "0",
        "EXPO_PUBLIC_API_URL": "https://xinchat.boostbunny.io",
        "EXPO_PUBLIC_LIVEKIT_URL": "wss://xinchat.boostbunny.io:7443"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "XINCHAT_TRUST_CERT": "0",
        "XINCHAT_ALLOW_CLEARTEXT": "0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.xinchat.mobile"
      },
      "ios": {
        "bundleIdentifier": "com.xinchat.mobile"
      }
    }
  }
}
