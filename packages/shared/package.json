{
  "name": "@qchat/shared",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.yaml -o ./src/generated.ts",
    "check": "openapi-typescript ./openapi.yaml -o ./src/generated.check.ts && diff -u ./src/generated.ts ./src/generated.check.ts && rm ./src/generated.check.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.1",
    "typescript": "^5.5.4"
  }
}
