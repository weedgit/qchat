# Copy to qchat-api.env and run ./deploy/rotate-jwt-secret.sh before production.
# Never commit real secrets. deploy/qchat-api.env is gitignored.

QCHAT_HTTP_ADDR=:8080
QCHAT_DATABASE_URL=postgres://qchat:qchat@localhost:5432/qchat?sslmode=disable
QCHAT_REDIS_URL=redis://localhost:6379/0
# Weak default for local only — rotate for any shared/production host.
QCHAT_JWT_SECRET=dev-qchat-secret-change-me
# Set to production to refuse the weak JWT default at API startup.
QCHAT_ENV=development
# Verification-code gateway. "dev" only logs codes and never sends an SMS, so
# QCHAT_ENV=production refuses to start with it. Registration and phone-change
# codes are returned in the API response as dev_code outside production only.
QCHAT_SMS_PROVIDER=dev
QCHAT_CORS_ORIGIN=*
QCHAT_OBJECT_STORAGE_URL=http://localhost:9000
QCHAT_BUCKET=qchat

# LiveKit (prefer sourcing deploy/generated/media.env after ./deploy/render-media-config.sh).
# Keys must match deploy/generated/livekit.yaml. Do not hardcode a machine IP in git.
# LIVEKIT_URL=ws://YOUR_HOST:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret-that-is-at-least-32-characters-long
