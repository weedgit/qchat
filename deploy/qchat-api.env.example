# Copy to qchat-api.env and run ./deploy/rotate-jwt-secret.sh before production.
# Never commit real secrets. deploy/qchat-api.env is gitignored.

QCHAT_HTTP_ADDR=:8080
QCHAT_DATABASE_URL=postgres://qchat:qchat@localhost:5432/qchat?sslmode=disable
QCHAT_REDIS_URL=redis://localhost:6379/0
# Weak default for local only — rotate for any shared/production host.
QCHAT_JWT_SECRET=dev-qchat-secret-change-me
# Set to production to refuse the weak JWT default at API startup.
QCHAT_ENV=development
QCHAT_CORS_ORIGIN=*
QCHAT_OBJECT_STORAGE_URL=http://localhost:9000
QCHAT_BUCKET=qchat
