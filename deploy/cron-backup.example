# Daily Postgres + uploads backup (RPO ≤ 24h).
# Install: sudo cp deploy/cron-backup.example /etc/cron.d/qchat-backup
# Adjust user/path for your host.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 02:15 UTC daily
15 2 * * * root cd /root/qchat && /root/qchat/deploy/backup.sh >> /var/log/qchat-backup.log 2>&1
