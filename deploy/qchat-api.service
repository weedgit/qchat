[Unit]
Description=Qchat API (Go backend)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/qchat/services/api
# media.env is optional (generated by deploy/render-media-config.sh on each host).
EnvironmentFile=-/root/qchat/deploy/generated/media.env
EnvironmentFile=-/root/qchat/deploy/qchat-api.env
ExecStart=/root/qchat/services/api/bin/qchat-api
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qchat-api

[Install]
WantedBy=multi-user.target
