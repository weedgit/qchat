# =============================================================================
# Qchat / XinChat public host configuration
# =============================================================================
# 1. Copy this file to deploy/hosts.env (gitignored)
# 2. Edit URLs below when you change domain or move servers
# 3. Run:  node scripts/sync-hosts-env.js
#    That updates each app's .env and desktop production.json files.
#
# Production apps should use HTTPS domains (Let's Encrypt). You do NOT need
# the raw VPS IP in code — DNS points your domain at the server.
# =============================================================================

# --- Rchat (main product) ---
RCHAT_ORIGIN=https://rchat.boostbunny.io
RCHAT_LIVEKIT_URL=wss://rchat.boostbunny.io:7443
RCHAT_DESKTOP_UPDATE_URL=https://rchat.boostbunny.io/desktop-updates/

# --- XinChat (sibling product, same API backend, /xin web UI) ---
XINCHAT_ORIGIN=https://xinchat.boostbunny.io
XINCHAT_WEB_PATH=/xin
XINCHAT_LIVEKIT_URL=wss://xinchat.boostbunny.io:7443
XINCHAT_DESKTOP_UPDATE_URL=https://xinchat.boostbunny.io/xin-desktop-updates/

# --- Local development (usually leave as-is) ---
LOCAL_RCHAT_WEB=http://localhost:3000
LOCAL_XINCHAT_WEB=http://localhost:3001/xin
LOCAL_ADMIN_WEB=http://localhost:3001/admin
LOCAL_API=http://localhost:8080

# --- Fallback by raw IP (uncomment only if DNS is unavailable) ---
# RCHAT_ORIGIN=https://YOUR_SERVER
# RCHAT_LIVEKIT_URL=wss://YOUR_SERVER:7443
# XINCHAT_ORIGIN=https://YOUR_SERVER
# XINCHAT_LIVEKIT_URL=wss://YOUR_SERVER:7443
# XINCHAT_DESKTOP_UPDATE_URL=https://YOUR_SERVER/xin-desktop-updates/